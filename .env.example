# Copy this file to .env and fill in your own values. NEVER commit .env.
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the public "anon" key. NEVER the service_role key.
SUPABASE_KEY=your_anon_key
PORT=8000

# ---- LLM provider: any OpenAI-compatible endpoint. Only these three values change per provider. ----
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_API_KEY=<your key>   LLM_MODEL=openrouter/free
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1/     LLM_API_KEY=ollama        LLM_MODEL=gemma3:1b
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_llm_key
LLM_MODEL=openrouter/free

# Behaviour switches (all optional)
LLM_STUB=0
LLM_ENABLED=true
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
